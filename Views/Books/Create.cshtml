@model mvc_project.Models.Book
@{ ViewData["Title"] = "Create Book"; }
<h1>Create Book</h1><hr />
<div class="row"><div class="col-md-6"><form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="PublishedYear" class="form-label"></label><input asp-for="PublishedYear" class="form-control" /><span asp-validation-for="PublishedYear" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="AuthorId" class="form-label">Author Id</label><input asp-for="AuthorId" class="form-control" /><small class="form-text text-muted">Create an author first and enter its Id.</small></div>
    <div class="mb-3"><label asp-for="CategoryId" class="form-label">Category Id</label><input asp-for="CategoryId" class="form-control" /><small class="form-text text-muted">Create a category first and enter its Id.</small></div>
    <div class="mb-3"><label asp-for="LibraryMemberId" class="form-label">Borrowed By Member Id (optional)</label><input asp-for="LibraryMemberId" class="form-control" /></div>
    <input type="submit" value="Create" /> <a asp-action="Index">Back to List</a>
</form></div></div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }

