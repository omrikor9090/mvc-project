@model IEnumerable<mvc_project.Models.Book>
@{ ViewData["Title"] = "Books"; }
<h1>Books</h1>
<p><a asp-action="Create">Create New Book</a></p>
<table class="table table-striped">
    <thead><tr><th>Title</th><th>Published Year</th><th>Author</th><th>Category</th><th>Borrowed By</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td><td>@item.PublishedYear</td>
            <td>@item.Author?.Name</td><td>@item.Category?.Name</td><td>@item.LibraryMember?.Name</td>
            <td><a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | <a asp-action="Details" asp-route-id="@item.Id">Details</a> | <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></td>
        </tr>
    }
    </tbody>
</table>

