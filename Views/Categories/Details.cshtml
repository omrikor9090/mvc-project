@model mvc_project.Models.Category
@{ ViewData["Title"] = "Category Details"; }
<h1>Category Details</h1><hr /><dl class="row"><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd><dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd><dt class="col-sm-3">Books</dt><dd class="col-sm-9">@Model.Books.Count</dd></dl>
<a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> | <a asp-action="Index">Back to List</a>

