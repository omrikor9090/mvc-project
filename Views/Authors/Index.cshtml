@model IEnumerable<mvc_project.Models.Author>
@{ ViewData["Title"] = "Authors"; }
<h1>Authors</h1><p><a asp-action="Create">Create New Author</a></p>
<table class="table table-striped"><thead><tr><th>Name</th><th>Country</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Name</td><td>@item.Country</td><td><a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | <a asp-action="Details" asp-route-id="@item.Id">Details</a> | <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr> }
</tbody></table>

