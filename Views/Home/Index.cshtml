<ul>
    <li><a href="https://www.goodreads.com/" target="_blank">Goodreads</a></li>
    <li><a href="https://www.gutenberg.org/" target="_blank">Project Gutenberg</a></li>
    <li><a href="https://archive.org/details/texts" target="_blank">Internet Archive</a></li>
</ul>
