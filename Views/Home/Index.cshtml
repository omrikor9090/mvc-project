@{
    ViewData["Title"] = "Library Home";
}

<div class="text-center mb-4">
    <h1 class="display-4">Library</h1>
</div>

<h2>Library tables</h2>
<div>
    <a asp-controller="Books" asp-action="Index">View Books</a>
